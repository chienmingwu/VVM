#!/bin/bash
# These are the PBS Directives
#PBS -N expname
#PBS -A NMMM0004
#PBS -j oe

#PBS -q develop
#PBS -l walltime=06:00:00
#PBS -l select=np_nodes:ncpus=128:mpiprocs=128:ompthreads=1:mem=80gb

## #PBS -q main
## #PBS -l walltime=12:00:00
## #PBS -l select=np_nodes:ncpus=128:mpiprocs=128:ompthreads=1


module --force purge
module load ncarenv/25.10
module load intel/2025.2.1
module load cray-mpich/8.1.32
module load ncarcompilers/1.1.0
module load hdf5/1.14.6
module load netcdf/4.9.3
module load parallel-netcdf/1.14.1
module load mkl/2025.2.0

ulimit -s unlimited
export EXPHDR_tmp='expname ../../DATA/expname'

date > runtime

mpiexec -np 1 ./create_topolsm
mpiexec -np total_cores -ppn 128 ./vvm < INPUT | tee OUTPUT  

date >> runtime
bash make_ctl_bash.sh


